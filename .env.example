# ==============================================================================
# APPLICATION & MULTI-TENANT ROUTING
# ==============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Root SaaS domain used for tenant subdomains: {tenant}.yourdomain.in
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_PLATFORM_HOST=platform.localhost:3000
NEXT_PUBLIC_DASHBOARD_HOST=app.localhost:3000
NEXT_PUBLIC_PROTOCOL=http

# ==============================================================================
# DATABASE (PostgreSQL 16+ / Supabase Mumbai ap-south-1)
# ==============================================================================
# Transaction pooler URL (port 6543) for runtime queries
DATABASE_URL=postgresql://postgres.projectref:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Direct session URL (port 5432) for Drizzle migrations and DDL
DIRECT_DATABASE_URL=postgresql://postgres.projectref:CHANGE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ==============================================================================
# SUPABASE AUTH & STORAGE
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://projectref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_PUBLIC_BUCKET=website-media
SUPABASE_STORAGE_PRIVATE_BUCKET=tenant-documents

# ==============================================================================
# PAYMENTS (Simulated MVP P0 / Razorpay Primary / Cashfree Secondary)
# ==============================================================================
PAYMENT_DEFAULT_PROVIDER=simulated

# Razorpay (never expose KEY_SECRET or WEBHOOK_SECRET to client)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_RAZORPAY_WEBHOOK_SECRET

# Cashfree readiness (optional secondary gateway)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# ==============================================================================
# NOTIFICATIONS (Email MVP + WhatsApp/SMS Readiness)
# ==============================================================================
EMAIL_FROM_ADDRESS=bookings@notifications.yourdomain.in
RESEND_API_KEY=re_CHANGE_ME

# Phase-2 WhatsApp / SMS gateway readiness (Gupshup / MSG91 / Meta Cloud API)
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_KEY=
SMS_PROVIDER=disabled
SMS_API_KEY=

# ==============================================================================
# SECURITY, RATE LIMITING & CRON JOBS
# ==============================================================================
# Shared secret verifying internal scheduled jobs (e.g. hold expiration sweep)
CRON_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET

# Optional Upstash Redis for distributed rate limiting across serverless instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Booking Hold TTL in seconds (default: 480s = 8 minutes for UPI intent completion)
BOOKING_HOLD_TTL_SECONDS=480
